# ===================================================================
# CONFIGURACAO DO AMBIENTE — DOCKER (DEV E PROD)
# ===================================================================
#
# Como usar:
#   cp .env.docker .env
#
# DESENVOLVIMENTO (WSL2/local, Apache via docker-compose.yml):
#   docker compose up -d
#   Acesso: http://localhost:8080
#   Frontend (hot reload): npm install && npm run dev
#
# PRODUCAO (Ubuntu Server, Nginx via docker-compose.prod.yml):
#   docker compose -f docker-compose.prod.yml up -d --build
#   Acesso: http://<ip-do-servidor> (porta 80)
#   IMPORTANTE: trocar todas as senhas (DB_ROOT_PASSWORD, DB_PASS)
#   antes de subir em producao.
#
# ===================================================================

# Ambiente (sobreescrito pelo docker-compose: development p/ dev, production p/ prod)
CAMERAS_ENV=production

# Banco de Dados
DB_HOST=db
DB_NAME=cftv_gml
DB_USER=cftv_user
# IMPORTANTE: trocar em producao
DB_PASS=ALTERE_ESTA_SENHA

# Senha root MySQL (usada pelo compose para criar o banco)
DB_ROOT_PASSWORD=ALTERE_ESTA_SENHA_ROOT

# Timezone
APP_TIMEZONE=America/Sao_Paulo

# Sessao (segundos)
CAMERAS_SESSION_TIMEOUT=3600
CAMERAS_SESSION_ABSOLUTE_TIMEOUT=28800

# CSP (0=strict, 1=permite inline styles)
# Em dev, o docker-compose.yml sobrescreve para 1 (Bootstrap)
CAMERAS_CSP_ALLOW_INLINE_STYLES=0

# Sentry (opcional — em branco desativa)
SENTRY_DSN=

# --- Producao (apenas p/ docker-compose.prod.yml) ---
# Para usar imagem do registry (ao inves de build local):
#   GITHUB_REPOSITORY=ghostterminals/sistema-cameras-v1.0
#   APP_TAG=latest
#GITHUB_REPOSITORY=ghostterminals/sistema-cameras-v1.0
#APP_TAG=latest
