# ===================================================================
# CONFIGURACAO DO AMBIENTE - DOCKER
# ===================================================================
#
# Copie este arquivo para .env e ajuste os valores:
#   cp .env.docker .env
#
# Para subir o container:
#   docker compose up -d
#
# ===================================================================

# Ambiente
CAMERAS_ENV=production

# Banco de Dados
DB_HOST=db
DB_NAME=cftv_gml
DB_USER=cftv_user
DB_PASS=ALTERE_ESTA_SENHA

# Senha root MySQL (usada pelo docker-compose para criar o banco)
DB_ROOT_PASSWORD=ALTERE_ESTA_SENHA_ROOT

# Timezone
APP_TIMEZONE=America/Sao_Paulo

# Sessao (segundos)
CAMERAS_SESSION_TIMEOUT=3600
CAMERAS_SESSION_ABSOLUTE_TIMEOUT=28800

# CSP (0=strict, 1=permite inline styles)
CAMERAS_CSP_ALLOW_INLINE_STYLES=0

# Sentry (opcional)
SENTRY_DSN=
