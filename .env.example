# ===================================================================
# CONFIGURAÇÃO DO AMBIENTE - SISTEMA DE CÂMERAS
# ===================================================================
#
# INSTRUÇÕES:
# ----------
# 1. Este é um ARQUIVO DE EXEMPLO - NAO CONTEM DADOS REAIS
# 2. Para configurar o ambiente, crie o arquivo de configuração REAL em:
#    - WINDOWS (desenvolvimento): C:\env\sistema-cameras\.env
#    - LINUX (produção):          /etc/sistema-cameras/.env
# 3. Use este arquivo como template para criar sua configuração
#
# PASTAS EXTERNAS OBRIGATÓRIAS:
# -----------------------------
# Windows: C:\env\sistema-cameras\ (criar manualmente)
# Linux:   /etc/sistema-cameras/   (criar com: sudo mkdir -p /etc/sistema-cameras)
#
# ===================================================================

# Ambiente: development, testing, production
CAMERAS_ENV=development

# Banco de Dados - CONFIGURE NA PASTA EXTERNA
DB_HOST=localhost
DB_NAME=cftv_gml
DB_USER=SEU_USUARIO_AQUI
DB_PASS=SUA_SENHA_AQUI

# Proxy Confiavel (X-Forwarded-For trust)
# IPs separados por vírgula. Deixe vazio se não usar proxy.
PROXY_TRUSTED_IPS=

# Origens CORS (separadas por vírgula). Deixe vazio para same-origin.
APP_ALLOWED_ORIGINS=

# Aplicação
APP_TIMEZONE=America/Sao_Paulo

# Sessão (segundos)
CAMERAS_SESSION_TIMEOUT=3600
CAMERAS_SESSION_ABSOLUTE_TIMEOUT=28800

# CSP (0=strict, 1=permite inline styles p/ Bootstrap)
CAMERAS_CSP_ALLOW_INLINE_STYLES=0

# Sentry DSN (opcional - habilita error tracking em producao)
# Obtenha seu DSN em: https://sentry.io
SENTRY_DSN=

# Vite Dev Server: URL base da API para o proxy
# Usado em vite.config.ts para redirecionar chamadas à API durante
# desenvolvimento. Exemplo: VITE_API_URL=http://localhost:80
# Se omitido, usa http://localhost:80 como fallback.
# EM PRODUCAO: NAO USADO (as chamadas vao direto pro mesmo dominio).
VITE_API_URL=http://localhost:80