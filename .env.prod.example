# ===================================================================
# CONFIGURACAO DO AMBIENTE — PRODUCAO (docker-compose.prod.yml)
# ===================================================================
#
# Como usar no servidor Ubuntu:
#   cp .env.prod.example .env
#   # edite as senhas abaixo com valores fortes
#   docker compose -f docker-compose.prod.yml up -d --build
#
# IMPORTANTE:
#   - Troque TODAS as senhas (DB_ROOT_PASSWORD, DB_PASS) por valores
#     fortes e unicos antes de subir em producao.
#   - Este arquivo NAO deve ser versionado com valores reais.
#   - O compose falha se DB_ROOT_PASSWORD ou DB_PASS estiverem vazios
#     (variaveis marcadas com :?required).
# ===================================================================

# ---------- Banco de Dados ----------
# Senha root do MySQL (usada pelo compose para inicializar o banco)
DB_ROOT_PASSWORD=ALTERE_ESTA_SENHA_ROOT

# Nome / usuario / senha do banco da aplicacao
DB_NAME=cftv_gml
DB_USER=cftv_user
DB_PASS=ALTERE_ESTA_SENHA

# ---------- Aplicacao ----------
# Timezone
APP_TIMEZONE=America/Sao_Paulo

# Sessao (segundos)
CAMERAS_SESSION_TIMEOUT=3600
CAMERAS_SESSION_ABSOLUTE_TIMEOUT=28800

# CSP (0=strict, 1=permite inline styles)
CAMERAS_CSP_ALLOW_INLINE_STYLES=0

# Sentry (opcional — em branco desativa error tracking)
SENTRY_DSN=

# ---------- Rede ----------
# IPs de proxy confiaveis (deixe vazio se sem proxy reverso).
# Ex.: se houver um load balancer/nginx externo fazendo terminação TLS.
PROXY_TRUSTED_IPS=