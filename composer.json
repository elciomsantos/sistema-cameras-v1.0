{
    "name": "gml/sistema-cameras",
    "description": "Sistema de Gerenciamento de Câmeras de Segurança",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": ">=8.4.1",
        "monolog/monolog": "^3.10"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0",
        "roave/security-advisories": "dev-latest",
        "sentry/sentry": "^4.30",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "config/app.php",
            "config/database.php",
            "config/logger.php",
            "config/sentry.php",
            "inc/security.php",
            "inc/single_session.php",
            "src/ErrorHandler.php"
        ]
    },
    "scripts": {
        "test": "phpunit --do-not-cache-result",
        "lint": "find . -name '*.php' -not -path './vendor/*' -exec php -l {} \\;",
        "security-audit": "composer audit",
        "migrate": "php database/migrate.php",
        "migrate:status": "php database/migrate.php --status",
        "migrate:rollback": "php database/migrate.php --down 1"
    },
    "config": {
        "disable-tls": false,
        "sort-packages": true,
        "classmap-authoritative": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    }
}
