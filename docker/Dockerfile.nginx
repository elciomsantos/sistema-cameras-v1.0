# ============================================
# Build stage — compilar assets (Vite)
# ============================================
FROM node:20-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY vite.config.ts tsconfig.json postcss.config.js ./
COPY src/ src/
COPY public/ public/
COPY scripts/ scripts/
RUN npm run build

# ============================================
# PHP-FPM + Nginx
# ============================================
FROM php:8.4-fpm

LABEL org.opencontainers.image.source="https://github.com/elciomsantos/sistema-cameras-v1.0"
LABEL org.opencontainers.image.description="Sistema de Gerenciamento de Cameras e Alarmes (Nginx)"
LABEL org.opencontainers.image.licenses="MIT"

ARG DEBIAN_FRONTEND=noninteractive

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
        nginx curl libpng-dev libzip-dev libonig-dev \
        libxml2-dev libcurl4-openssl-dev pkg-config libssl-dev \
        libbrotli-dev libnginx-mod-http-brotli-static \
        locales \
    && sed -i 's/# pt_BR.UTF-8/pt_BR.UTF-8/' /etc/locale.gen \
    && locale-gen pt_BR.UTF-8 \
    && docker-php-ext-install pdo_mysql mbstring zip gd xml curl \
    && pecl install apcu && docker-php-ext-enable apcu \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copiar composer e instalar dependencias PHP
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

WORKDIR /var/www/html

COPY composer.json composer.lock ./

# Copiar codigo-fonte antes do composer install (classmap precisa do src/)
COPY . .

RUN composer install --no-interaction --optimize-autoloader --classmap-authoritative --no-dev

# Copiar assets buildados do stage de build (public/assets/ e public/sw-assets.json)
COPY --from=build /app/public/assets/ public/assets/
COPY --from=build /app/public/sw-assets.json public/sw-assets.json

# Configuracoes PHP
RUN echo "memory_limit = 256M" > /usr/local/etc/php/conf.d/memory.ini \
    && echo "upload_max_filesize = 20M" > /usr/local/etc/php/conf.d/upload.ini \
    && echo "post_max_size = 20M" >> /usr/local/etc/php/conf.d/upload.ini \
    && echo "max_execution_time = 120" > /usr/local/etc/php/conf.d/timeout.ini \
    && echo "opcache.enable=1" > /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.memory_consumption=128" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.interned_strings_buffer=8" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.max_accelerated_files=10000" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.revalidate_freq=2" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.save_comments=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "apc.enabled=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "apc.shm_size=32M" >> /usr/local/etc/php/conf.d/opcache.ini

# Configurar PHP-FPM para ouvir na porta 9000
RUN sed -i 's|^listen = /run/php/php8.4-fpm.sock|listen = 9000|' /usr/local/etc/php-fpm.d/www.conf \
    && sed -i 's|^;clear_env = no|clear_env = no|' /usr/local/etc/php-fpm.d/www.conf

# Copiar configuracao do Nginx
COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY docker/conf.d/default.conf /etc/nginx/conf.d/default.conf

# Diretorios de storage
RUN mkdir -p storage/ratelimit storage/cep_cache public/uploads \
    && chown -R www-data:www-data storage public/uploads \
    && chmod -R 755 storage public/uploads

ENV CAMERAS_ENV=production

# Remover default do Nginx (evitar conflito)
RUN rm -f /etc/nginx/sites-enabled/default \
    && mkdir -p /run/php /var/cache/nginx /var/log/nginx /var/lib/nginx/body \
    && touch /run/php/php-fpm.pid /var/run/nginx.pid /var/log/nginx/access.log /var/log/nginx/error.log \
    && chown -R www-data:www-data /run/php /var/cache/nginx /var/log/nginx /var/lib/nginx \
    && chown www-data:www-data /var/run/nginx.pid

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -sf http://localhost:8080/ || exit 1

# Rodar como www-data (nao root) — nginx master + php-fpm
USER www-data

CMD ["sh", "-c", "nginx -g 'daemon off;' & exec php-fpm --nodaemonize"]
