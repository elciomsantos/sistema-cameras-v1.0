Options -Indexes

RewriteEngine On

# ============================================
# mod_deflate — compressão on-the-fly
# ============================================
<IfModule mod_deflate.c>
    # Comprimir respostas HTML, CSS, JS, JSON, XML, SVG
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject

    # Não comprimir imagens (já comprimidas)
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE !image/jpeg !image/png !image/gif !image/webp
    </IfModule>

    # Vary: Accept-Encoding — essencial para proxies/CDN servirem versões corretas
    <IfModule mod_headers.c>
        Header unset Server
        Header unset X-Powered-By
        <FilesMatch "\.(css|js|json|xml|html|svg|ttf|otf|woff|woff2)$">
            Header append Vary "Accept-Encoding"
        </FilesMatch>
    </IfModule>
</IfModule>

# ============================================
# Cache-Control para assets estáticos
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
</IfModule>

# ============================================
# Cache-Control: immutable para assets com hash (Vite)
# ============================================
<IfModule mod_headers.c>
    # Assets Vite com hash no nome: imutáveis, cache longo sem revalidação
    <FilesMatch "assets/[^/]+-[a-f0-9]{8}\.(js|css|map)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Fonte WOFF2
    <FilesMatch "\.woff2$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ============================================
# Servir arquivos precomprimidos (.br e .gz gerados pelo Vite)
# Brotli tem prioridade quando o cliente aceita ambos.
# ============================================
<IfModule mod_rewrite.c>
    <IfModule mod_headers.c>
        # Brotli: ~15-20% menor que gzip. Clientes modernos enviam "br" primeiro.
        RewriteCond %{HTTP:Accept-Encoding} br
        RewriteCond %{REQUEST_FILENAME}\.br -f
        RewriteRule ^(.+)\.(js|css|json|xml|svg|html|txt|map)$ $1.$2.br [L]

        # Fallback gzip para clientes sem suporte a brotli
        RewriteCond %{HTTP:Accept-Encoding} gzip
        RewriteCond %{REQUEST_FILENAME}\.gz -f
        RewriteRule ^(.+)\.(js|css|json|xml|svg|html|txt|map)$ $1.$2.gz [L]

        # Definir Content-Encoding correto para os arquivos precomprimidos
        <FilesMatch "\.br$">
            Header set Content-Encoding br
            Header set Vary "Accept-Encoding"
        </FilesMatch>
        <FilesMatch "\.gz$">
            Header set Content-Encoding gzip
            Header set Vary "Accept-Encoding"
        </FilesMatch>
    </IfModule>
</IfModule>

# Bloquear acesso a arquivos-sensiveis (exceto sw-assets.json para PWA)
<If "! %{REQUEST_URI} =~ m#sw-assets\.json$#">
    <FilesMatch "\.(env|sql|md|log|yml|yaml|json|lock)$">
        Require all denied
    </FilesMatch>
</If>

# Bloquear acesso direto a pastas internas
RewriteRule ^(\.env|config/|inc/|src/|accounts/|auth/|api/|scripts/) - [F,L]

# Servir assets do Vite (js/css) diretamente, sem rewrite
RewriteRule ^assets/ - [L]

# Servir direto qq arquivo existente (imagens, js, css, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Caso contrario, envia para index.php
RewriteRule ^ index.php [QSA,L]
