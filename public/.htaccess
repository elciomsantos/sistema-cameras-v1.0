Options -Indexes

RewriteEngine On

# Bloquear acesso a arquivos-sensiveis (exceto sw-assets.json para PWA)
<If "! %{REQUEST_URI} =~ m#sw-assets\.json$#">
    <FilesMatch "\.(env|sql|md|log|yml|yaml|json|lock)$">
        Require all denied
    </FilesMatch>
</If>

# Bloquear acesso direto a pastas internas
RewriteRule ^(\.env|config/|inc/|src/|accounts/|auth/|api/|scripts/) - [F,L]

# Servir assets do Vite (js/css) diretamente, sem rewrite
RewriteRule ^assets/ - [L]

# Servir direto qq arquivo existente (imagens, js, css, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Caso contrario, envia para index.php
RewriteRule ^ index.php [QSA,L]
